font-family = JetBrains Mono
font-size = 12

window-padding-x = 16
window-padding-y = 16
window-padding-balance = true
window-decoration = false
gtk-titlebar = false
background-opacity = 0.92

cursor-style = bar
cursor-style-blink = true

confirm-close-surface = false

# Material You colors, generated by matugen (the ? prefix = don't complain if the file doesn't exist yet)
config-file = ?colors
